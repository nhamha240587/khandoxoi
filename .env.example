# ── Database (Neon PostgreSQL) ─────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ── SePay (Thanh toán QR) ──────────────────────────────────────────────────────
SEPAY_BANK_ACCOUNT=0123456789
SEPAY_BANK_CODE=VPB
SEPAY_ACCOUNT_NAME=BEP CO HA
# API key để xác thực webhook SePay (Cấu hình > Webhooks > API Key trên dashboard SePay)
SEPAY_API_KEY=your_sepay_api_key

# ── Telegram Bot (Thông báo đơn hàng) ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_ORDER_GROUP_ID=-100xxxxxxxxxx

# ── POScake / Pancake (Quản lý đơn) ───────────────────────────────────────────
PANCAKE_SHOP_ID=1234567890
PANCAKE_API_KEY=your_api_key_here
