# Database (Supabase / Neon / PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# SePay – Thanh toán QR
SEPAY_BANK_ACCOUNT=0123456789
SEPAY_BANK_CODE=MB
SEPAY_ACCOUNT_NAME=BEP CO HA

# Telegram – Thông báo đơn hàng
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ORDER_GROUP_ID=-100xxxxxxxxx

# POScake – Tạo đơn hàng tự động (tuỳ chọn)
PANCAKE_SHOP_ID=your_shop_id
PANCAKE_API_KEY=your_api_key
PANCAKE_VAR_NHO=variation_id_60x60
PANCAKE_VAR_LON=variation_id_90x100
